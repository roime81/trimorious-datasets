{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trimorious.org/schemas/v2/scientific-preference.schema.json",
  "title": "Trimorious scientific preference pair",
  "type": "object",
  "required": ["pair_id", "prompt", "chosen", "rejected", "rubric", "annotation", "provenance"],
  "properties": {
    "pair_id": {"type": "string"},
    "prompt": {"type": "string", "minLength": 1},
    "chosen": {"type": "string", "minLength": 1},
    "rejected": {"type": "string", "minLength": 1},
    "preference_dimensions": {"type": "array", "items": {"type": "string"}},
    "rubric": {"type": "object", "required": ["version"], "properties": {"version": {"type": "string"}, "criteria": {"type": "array", "items": {"type": "object"}}, "score_chosen": {"type": "number"}, "score_rejected": {"type": "number"}}, "additionalProperties": true},
    "rationale": {"type": "string"},
    "annotation": {
      "type": "object",
      "required": ["method", "review_status"],
      "properties": {
        "method": {"type": "string", "enum": ["expert_human", "trained_annotator", "adjudicated_panel", "model_assisted_human_verified"]},
        "annotator_ids_pseudonymous": {"type": "array", "items": {"type": "string"}},
        "agreement_statistic": {"type": "number"},
        "review_status": {"type": "string", "enum": ["pending", "reviewed", "adjudicated", "rejected"]},
        "adjudication_notes": {"type": "string"}
      },
      "additionalProperties": true
    },
    "provenance": {"type": "object", "required": ["origin_type"], "properties": {"origin_type": {"type": "string"}, "source_id": {"type": "string"}, "source_url": {"type": "string", "format": "uri"}, "license": {"type": "string"}}, "additionalProperties": true}
  },
  "additionalProperties": true
}
