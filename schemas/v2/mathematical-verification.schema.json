{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trimorious.org/schemas/v2/mathematical-verification.schema.json",
  "title": "Trimorious mathematical verification example",
  "type": "object",
  "required": ["example_id", "problem", "candidate_answer", "verification", "provenance"],
  "properties": {
    "example_id": {"type": "string"},
    "problem": {"type": "string", "minLength": 1},
    "domain": {"type": "string"},
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "candidate_steps": {"type": "array", "items": {"type": "object"}},
    "candidate_answer": {"type": "string"},
    "counterexample": {"type": "string"},
    "error_type": {"type": "string"},
    "verification": {
      "type": "object",
      "required": ["engine", "status"],
      "properties": {
        "engine": {"type": "string"},
        "engine_version": {"type": "string"},
        "status": {"type": "string", "enum": ["passed", "failed", "partial", "not_run"]},
        "expression": {"type": "string"},
        "expected": {"type": "string"},
        "actual": {"type": "string"},
        "tolerance": {"type": "number", "minimum": 0},
        "unit_check": {"type": "string", "enum": ["passed", "failed", "not_applicable", "not_run"]},
        "formal_proof_reference": {"type": "string"},
        "execution_log_hash": {"type": "string"}
      },
      "additionalProperties": true
    },
    "provenance": {"type": "object", "required": ["origin_type"], "properties": {"origin_type": {"type": "string"}, "source_ref": {"type": "string"}, "license": {"type": "string"}, "generator": {"type": "string"}, "review_status": {"type": "string"}}, "additionalProperties": true}
  },
  "additionalProperties": true
}
