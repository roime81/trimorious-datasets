{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trimorious.org/schemas/v2/scientific-instruction.schema.json",
  "title": "Trimorious scientific instruction example",
  "type": "object",
  "required": ["messages", "category", "provenance"],
  "properties": {
    "example_id": {"type": "string", "minLength": 1},
    "messages": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["role", "content"],
        "properties": {
          "role": {"type": "string", "enum": ["system", "user", "assistant", "tool"]},
          "content": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "category": {
      "type": "string",
      "enum": [
        "scientific_explanation", "hypothesis_generation", "hypothesis_testing",
        "causal_inference", "literature_review", "research_methodology",
        "peer_review", "scientific_criticism", "evidence_synthesis",
        "uncertainty_reasoning", "multidisciplinary_reasoning", "scientific_communication"
      ]
    },
    "domain": {"type": "string"},
    "subdomain": {"type": "string"},
    "language": {"type": "string", "minLength": 2},
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "evidence_refs": {"type": "array", "items": {"type": "string"}},
    "uncertainty": {
      "type": "object",
      "properties": {
        "level": {"type": "string", "enum": ["low", "medium", "high", "unknown"]},
        "rationale": {"type": "string"},
        "alternatives": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "provenance": {"$ref": "#/$defs/provenance"},
    "quality": {
      "type": "object",
      "properties": {
        "score": {"type": "number", "minimum": 0, "maximum": 1},
        "review_status": {"type": "string", "enum": ["unreviewed", "automated_check", "human_reviewed", "adjudicated"]},
        "review_notes": {"type": "string"}
      },
      "additionalProperties": true
    }
  },
  "$defs": {
    "provenance": {
      "type": "object",
      "required": ["origin_type"],
      "properties": {
        "origin_type": {"type": "string", "enum": ["licensed_source", "public_domain_source", "human_authored", "generated_and_verified", "translated_and_reviewed", "derived"]},
        "source_id": {"type": "string"},
        "source_url": {"type": "string", "format": "uri"},
        "doi": {"type": "string"},
        "license": {"type": "string"},
        "retrieved_at": {"type": "string", "format": "date-time"},
        "generation_model": {"type": "string"},
        "generation_prompt_version": {"type": "string"}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
