{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trimorious.org/schemas/v1/agentic-record.schema.json",
  "title": "Trimorious agentic reasoning record",
  "type": "object",
  "required": ["messages", "ground_truth"],
  "properties": {
    "messages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["role", "content"],
        "properties": {
          "role": {"type": "string", "minLength": 1},
          "content": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "ground_truth": {"type": "string", "minLength": 1}
  },
  "additionalProperties": true
}
